# Database
#
# Neon + Vercel recommendation:
# - DATABASE_URL: use the pooled Neon connection string for app runtime.
# - DIRECT_URL: keep the direct/unpooled Neon connection string for local Prisma
#   migrations and manual maintenance. The current Prisma schema does not require
#   DIRECT_URL at build time, so Vercel deployments only need DATABASE_URL unless
#   you add directUrl to prisma/schema.prisma.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Auth
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Email
RESEND_API_KEY=""
EMAIL_FROM=""

# Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# AI
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
AI_QUERY_EMBEDDING_MODEL="text-embedding-3-small"
